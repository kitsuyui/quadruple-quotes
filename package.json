{
  "name": "quadruple-quotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build:wasm": "wasm-pack build crates/wasm --target web --out-dir ../../apps/web/src/generated --out-name quadruple_quotes --no-pack --no-opt",
    "dev": "bun run build:wasm && vite --config apps/web/vite.config.ts",
    "build": "bun run build:wasm && bun run typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "cargo fmt --all && biome check --write .",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && biome check .",
    "test": "cargo test --workspace",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run test && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.2"
  }
}
