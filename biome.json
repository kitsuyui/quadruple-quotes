{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/generated",
      "!!**/dist",
      "!!**/target",
      "!!**/node_modules",
      "!!**/.tmp",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/.agent-inspect",
      "!!**/.audit-ledger"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
